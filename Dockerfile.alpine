# Alpine-based Dockerfile (smaller image, gcompat for glibc compatibility)

# ── Stage 1: Build ──
FROM oven/bun:1-debian AS build

WORKDIR /app

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile || bun install

COPY ./src ./src
COPY tsconfig.json ./

ENV NODE_ENV=production

# No explicit --target: Bun auto-detects the container's architecture
RUN bun build \
  --compile \
  --minify-whitespace \
  --minify-syntax \
  --outfile server \
  src/index.ts

RUN ls -lh /app/server

# ── Stage 2: Runtime (Alpine) ──
FROM alpine:3.21

# gcompat: glibc compatibility layer (Bun binaries link against glibc, Alpine uses musl)
# ca-certificates: required for HTTPS calls to Dynatrace APIs
# curl: used by HEALTHCHECK
RUN apk add --no-cache \
  gcompat \
  ca-certificates \
  curl

WORKDIR /app

COPY --from=build /app/server server
RUN chmod +x /app/server

ENV NODE_ENV=production
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

LABEL org.opencontainers.image.title="elysia-dynatrace-mcp-remote"
LABEL org.opencontainers.image.description="Dynatrace MCP Server (Remote) - ElysiaJS + Bun (Alpine)"
LABEL org.opencontainers.image.version="1.0.0"

CMD ["./server"]
