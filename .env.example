# Required: Dynatrace environment URL
DT_ENVIRONMENT=https://<environment-id>.apps.dynatrace.com

# Required: Platform Token for authentication
DT_PLATFORM_TOKEN=dt0c01.XXXXXXXX.YYYYYYYY

# Optional: Server configuration
PORT=3000
HOST=0.0.0.0

# Optional: CORS origins (comma-separated, * for all)
CORS_ORIGIN=*

# Optional: Grail query budget in GB (default: 1000, -1 for unlimited)
DT_GRAIL_QUERY_BUDGET_GB=1000

# Optional: Log level
LOG_LEVEL=info
